<odoo>
    <record id="res_config_settings_ai_inventory_crm" model="ir.ui.view">
        <field name="name">res.config.settings.ai.inventory.crm</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="AI Inventory CRM">
                    <setting string="AI API Key">
                        <field name="ai_api_key"/>
                    </setting>
                </block>
            </xpath>

        </field>
    </record>
</odoo>
