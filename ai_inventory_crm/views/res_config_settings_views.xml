<odoo>
    <record id="res_config_settings_ai_inventory_crm" model="ir.ui.view">
        <field name="name">res.config.settings.ai.inventory.crm</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='settings']" position="inside">
                <div class="app_settings_block">
                    <h2>AI Inventory CRM</h2>
                    <field name="ai_api_key"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>