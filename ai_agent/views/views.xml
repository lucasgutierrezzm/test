<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_agent_record_form" model="ir.ui.view">
        <field name="name">ai.agent.record.form</field>
        <field name="model">ai.agent.record</field>
        <field name="arch" type="xml">
            <form string="Registro IA">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="input_text" widget="text"/>
                    </group>
                    <group>
                        <!-- Este es el cambio importante -->
                        <field name="ai_summary" widget="text" 
                               options="{'rows': 5}" 
                               readonly="1"/>
                    </group>
                    <footer>
                        <button name="action_generate_summary" 
                                string="Generar resumen con IA" 
                                type="object" 
                                class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
