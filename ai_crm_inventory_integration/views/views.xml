<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Menú principal del módulo -->
        <menuitem id="menu_ai_crm_inventory_root"
                  name="AI CRM Integration"
                  sequence="100"
                  web_icon="ai_crm_inventory_integration,static/description/icon.png"
                  groups="base.group_system"/>

        <!-- Vista de configuración -->
        <record id="view_ai_crm_config_form" model="ir.ui.view">
    <field name="name">ai.crm.config.form</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="priority" eval="90"/>
    <field name="arch" type="xml">
        <xpath expr="//form" position="inside">

            <app name="ai_crm_inventory_integration" string="AI CRM Integration">

                <block title="Integración de IA con CRM e Inventario">

                    <setting string="Activar integración IA-CRM">
                        <field name="module_ai_crm_inventory_integration" widget="upgrade_boolean"/>
                        <div class="text-muted">
                            Permite al agente de IA crear oportunidades en CRM
                            basadas en consultas de productos del inventario.
                        </div>
                    </setting>

                </block>

                <block title="Configuración">

                    <div class="alert alert-info" role="status">
                        <h4 class="alert-heading">Pasos para usar esta funcionalidad</h4>
                        <ol>
                            <li>Crea una Acción del Servidor en Ajustes → Técnico → Acciones</li>
                            <li>Asocia la acción a un Tema de IA</li>
                            <li>Configura tu agente de IA con el tema creado</li>
                        </ol>
                        <p class="mb-0">
                            <a href="https://www.odoo.com/documentation/19.0/applications/productivity/ai.html"
                               target="_blank">Ver documentación completa</a>
                        </p>
                    </div>

                </block>

            </app>

        </xpath>
    </field>
</record>
    </data>
</odoo>
